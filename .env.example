# Database
DATABASE_URL=postgresql://user:password@localhost:5432/financeflow

# Auth — generate a strong key (do NOT commit real values):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
GEMINI_API_KEY=

# Mono (Nigeria) - optional when USE_MOCK_MONO=true
MONO_SECRET_KEY=
MONO_PUBLIC_KEY=
MONO_ENV=test
MONO_WEBHOOK_SECRET=

# Simulate Mono API with local mock transaction data (no live Mono calls)
USE_MOCK_MONO=true

# Paystack billing
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional: recurring plan codes created in Paystack dashboard (monthly)
# PAYSTACK_PLAN_STARTER=PLN_xxx
# PAYSTACK_PLAN_GROWTH=PLN_yyy
# PAYSTACK_PLAN_BUSINESS=PLN_zzz

# Admin is NOT granted from this list on register/login.
# Promote users via the admin API or a controlled DB update only.
# ADMIN_EMAILS=

# Frontend
FRONTEND_URL=http://localhost:3000
