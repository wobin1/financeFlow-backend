# Database
DATABASE_URL=postgresql://user:password@localhost:5432/financeflow

# Auth — generate a strong key (do NOT commit real values):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
GEMINI_API_KEY=

# Mono (Nigeria) - optional when USE_MOCK_MONO=true
MONO_SECRET_KEY=
MONO_PUBLIC_KEY=
MONO_ENV=test
MONO_WEBHOOK_SECRET=

# Simulate Mono API with local mock transaction data (no live Mono calls)
USE_MOCK_MONO=true

# Paystack billing
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional: recurring plan codes created in Paystack dashboard (monthly)
# PAYSTACK_PLAN_STARTER=PLN_xxx
# PAYSTACK_PLAN_GROWTH=PLN_yyy
# PAYSTACK_PLAN_BUSINESS=PLN_zzz

# Admin is NOT granted from this list on register/login.
# Promote users via the admin API or a controlled DB update only.
# ADMIN_EMAILS=

# Email — Zoho Mail REST API (OAuth2 self-client refresh token).
# Leave EMAILS_ENABLED=false in dev: emails are logged, and new accounts are
# auto-verified so the hard login gate doesn't lock you out.
EMAILS_ENABLED=false
EMAIL_FROM_NAME=FinanceFlow
# Create a Self Client at https://api-console.zoho.com with scopes:
#   ZohoMail.messages.CREATE,ZohoMail.accounts.READ
# then exchange for a refresh token.
# Or keep only messages.CREATE and pin ZOHO_ACCOUNT_ID (recommended).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# The Zoho mailbox mail is sent from (e.g. no-reply@yourdomain.com)
ZOHO_FROM_ADDRESS=
# Strongly recommended — skips GET /api/accounts (avoids accounts.READ scope).
# Find it: Zoho Mail → Settings → Mail Accounts, or inspect network calls
# to mail.zoho.com/api/accounts/{accountId}/...
# ZOHO_ACCOUNT_ID=
# Match your Zoho data center (.com, .eu, .in, .com.au, .jp)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAIL_API_URL=https://mail.zoho.com
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30

# Frontend
FRONTEND_URL=http://localhost:3000
